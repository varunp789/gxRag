NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
POSTGRES_DB=gxrag
POSTGRES_USER=gxrag
POSTGRES_PASSWORD=gxrag
REDIS_URL=redis://localhost:6379/0

# --- Runtime mode. Anything but "development" requires jwt auth + a database.
GXRAG_ENVIRONMENT=development
GXRAG_AUTH_MODE=dev
# GXRAG_JWT_SECRET=<at least 32 random characters>
# GXRAG_JWT_ISSUER=gxrag
# GXRAG_DATABASE_URL=postgresql://gxrag:gxrag@localhost:5432/gxrag

# --- Queue, artifacts, local fallbacks
GXRAG_REDIS_URL=redis://localhost:6379/0
GXRAG_PROCESSING_STATE_PATH=.gxrag/processing-state.json
GXRAG_ARTIFACT_ROOT=.gxrag/artifacts
GXRAG_PROCESSING_QUEUE=asset-processing

# --- Index backends
GXRAG_VECTOR_DATABASE_URL=postgresql://gxrag:gxrag@localhost:5432/gxrag
GXRAG_OPENSEARCH_URL=http://localhost:9200
GXRAG_ARANGODB_URL=http://localhost:8529
GXRAG_ARANGODB_DATABASE=gxrag
GXRAG_ARANGODB_USERNAME=root
GXRAG_ARANGODB_PASSWORD=gxrag

# --- Providers, billing, webhooks, governance
GXRAG_OPENAI_API_KEY=
GXRAG_WEBHOOK_SECRET=change-this-local-webhook-secret
GXRAG_STRIPE_SECRET_KEY=
GXRAG_STRIPE_WEBHOOK_SECRET=
GXRAG_BILLING_RETURN_ORIGINS=["http://localhost:3000"]
GXRAG_RETENTION_DAYS=30
GXRAG_RATE_LIMIT_PER_MINUTE=120

# --- Web app (server-side only): use a user JWT or API key instead of dev headers
# GXRAG_API_TOKEN=
# GXRAG_WORKSPACE_ID=ws_orbit_prod

ARANGODB_URL=http://localhost:8529
ARANGODB_ROOT_PASSWORD=gxrag
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeThisLocalOnly123!
